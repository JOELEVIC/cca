NODE_ENV=development
PORT=4000

# Database (optional for cca - gameplay-only; ccanext owns persistence)
# DATABASE_URL=postgresql://postgres:password@db.project.supabase.co:6543/postgres?pgbouncer=true
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key

# JWT (min 32 chars)
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS - For Render: comma-separated frontend origins (e.g. https://cm.dchessacademy.com)
CORS_ORIGIN=http://localhost:3000

# Main API (ccanext) endpoint — used to validate bearer tokens if local JWT
# verification fails. Default: https://api.dchessacademy.com/api/graphql
# MAIN_API_URL=https://api.dchessacademy.com/api/graphql
